# Copy to .env for local use, or paste these as Environment Variables in the
# RunPod template / pod config. Every one has a working default — you only need
# to set something here if you want to change behaviour.

# ---------------------------------------------------------------- checkpoints
# Comma-separated. Run ./scripts/download_models.sh --list to see all keys.
#   v23-sfw  best prompt adherence (default)
#   v19-sfw  best edit consistency — subjects keep their identity
#   *-nsfw   the author's uncensored merges
MODELS=v23-sfw

# Optional but recommended. The Phr00t repo is PUBLIC so downloads work without
# it, but authenticated requests get higher rate limits and Xet-accelerated
# transfer — worth having on a 28 GB file. Read-only token is enough:
# https://huggingface.co/settings/tokens
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------------------------- layout
# Data (models, outputs, workflows) — must be on the network volume.
# COMFY_DATA=/workspace/ComfyUI
# ComfyUI source. Bootstrap flow: same as COMFY_DATA. Docker flow: /opt/ComfyUI.
# COMFY_SRC=/workspace/ComfyUI
# VENV_DIR=/workspace/ComfyUI/venv

# --------------------------------------------------------------- encoder node
# append    (default) append a fixed redefinition to ComfyUI's nodes_qwen.py
# overwrite replace that file with the author's version (drops a core node)
# none      keep the stock node and live with the zoom/crop quirk
# PATCH_MODE=append

# ------------------------------------------------------------------- comfyui
# COMFY_PORT=8188
# COMFYUI_REF=master
# INSTALL_MANAGER=1

# ComfyUI is NOT auto-updated on boot (a silent pull is how a working pod breaks).
# Set this to pull COMFYUI_REF on the next start.
# UPDATE_COMFYUI=0

# Extra flags appended to main.py. Useful ones:
#   --lowvram        force the text encoder onto CPU (24 GB cards)
#   --fast-disk      prefer NVMe-backed offload over unpinned RAM
#   --cache-none     free each node's output immediately, lowest RAM ceiling
# COMFY_EXTRA_ARGS=

# Pin a CUDA build of torch instead of the PyPI default (Blackwell etc.)
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128

# --------------------------------------------------------------------- flags
# Overwrite bundled workflows on every boot, discarding your edits.
# FORCE_WORKFLOWS=0
# Skip provisioning entirely and just launch ComfyUI (fast restarts).
# SKIP_PROVISION=0
